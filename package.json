{
  "name": "holtwick-voxel",
  "private": true,
  "version": "0.0.1",
  "description": "Voxel rogue-like 3D version of Holtwick Tavern — Three.js + in-browser NPCs (Cloudflare/Groq) + procedural village. Live: https://voxel.heck.games",
  "homepage": "https://voxel.heck.games",
  "repository": {
    "type": "git",
    "url": "https://github.com/heck-games/holtwick-voxel.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "check:data": "tsx scripts/checkData.ts",
    "validate:visual": "node scripts/validate-visual.mjs",
    "check:ui": "node scripts/check-glow-hint.mjs",
    "test:dialog": "node scripts/test-dialog.mjs",
    "gen:sprites": "node tools/genSprites.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
